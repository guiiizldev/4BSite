[Unit]
Description=4Byts Customer Portal API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/4byts
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4310
Environment=DATABASE_PATH=/var/lib/4byts/4byts.db
ExecStart=/usr/bin/node /var/www/4byts/server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/4byts

[Install]
WantedBy=multi-user.target
